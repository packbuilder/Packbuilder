
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libicu72 \
        libssl3 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY artifacts/efbundle /app/efbundle

RUN chmod +x /app/efbundle

ENTRYPOINT ["/app/efbundle"]
